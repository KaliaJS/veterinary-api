includes:
    - vendor/larastan/larastan/extension.neon
    # Résorbée le 24.10.2026 : il reste cinq faux positifs des seeders
    # (tableaux de démo, `$this->command` nullable) ; le reste du code
    # passe sans erreur
    - phpstan-baseline.neon

parameters:
    paths:
        - app
        - database
        - routes
    level: 5
    tmpDir: storage/framework/cache/phpstan
    # Les casts des modèles sont déclarés dans casts() avec un @return
    # générique : Larastan doit lire le tableau retourné
    parseModelCastsMethod: true
