APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SANCTUM_TOKEN_EXPIRATION=1440

# Front Vue (../veterinary-web). WebAuthn est lié au domaine du FRONT —
# jamais à celui de l'API : PASSKEY_RP_ID et PASSKEY_ALLOWED_ORIGINS se
# déduisent de FRONTEND_URL (les surcharger seulement si le front est
# servi sous plusieurs origines).
#
# Dev, front Vite (`npm run dev`) : http://localhost:5173 — `localhost`
# est un contexte sécurisé sans TLS, rien d'autre à faire.
#   FRONTEND_URL=http://localhost:5173
#
# Dev, front servi par Herd : le site doit être en HTTPS (`herd secure
# veterinary-web`), WebAuthn refuse http://veterinary-web.test.
#   FRONTEND_URL=https://veterinary-web.test
#
# Dev, front Vite sous son propre hôte (comme foodtruck) : entrée
# `127.0.0.1 app.veterinary.local` dans /etc/hosts, certificat mkcert
# dans ../veterinary-web, Vite en HTTPS sur le port 5174, et l'API
# en HTTPS (`herd secure veterinary-api`) pour éviter le contenu mixte.
#   FRONTEND_URL=https://app.veterinary.local:5174
#
# Un seul RP ID par déploiement : les origines listées doivent toutes
# être sur ce domaine (ou un sous-domaine).
FRONTEND_URL=http://localhost:5173
#PASSKEY_RP_ID=localhost
#PASSKEY_ALLOWED_ORIGINS=http://localhost:5173
