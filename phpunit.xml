<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- Toute la suite tourne dans un seul processus : les images de
             test (GD) dépassent les 128 Mo par défaut vers la fin -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="ANNUAIRE_CACHE_SECONDES" value="0"/>
        <env name="ACCES_SUR_INVITATION" value="false" force="true"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <!-- Les tests n'écrivent pas dans storage/logs/laravel.log (24.10.2026) -->
        <env name="LOG_CHANNEL" value="null"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- Suite hermétique : jamais les vraies clés du .env, jamais de
             réseau (Http::preventStrayRequests dans TestCase) -->
        <env name="STRIPE_KEY" value="" force="true"/>
        <env name="STRIPE_SECRET" value="" force="true"/>
        <env name="STRIPE_WEBHOOK_SECRET" value="" force="true"/>
        <env name="STRIPE_WEBHOOK_SECRET_COMPTES" value="" force="true"/>
        <env name="ANTHROPIC_API_KEY" value="" force="true"/>
        <env name="DEEPGRAM_API_KEY" value="" force="true"/>
        <env name="CLOUDFLARE_API_TOKEN" value="" force="true"/>
        <env name="CLOUDFLARE_ZONE_ID" value="" force="true"/>
        <env name="REFDATA_API_KEY" value="" force="true"/>
        <env name="AWS_ACCESS_KEY_ID" value="" force="true"/>
        <env name="AWS_SECRET_ACCESS_KEY" value="" force="true"/>
        <env name="MAIL_PASSWORD" value="" force="true"/>
        <!-- Apple (APNs) : jamais la clé du .env (aucune notification réelle) -->
        <env name="APNS_PRIVATE_KEY_BASE64" value="" force="true"/>
        <!-- TURN de Cloudflare : jamais la clé du .env (STUN seul dans les essais) -->
        <env name="CLOUDFLARE_TURN_KEY_ID" value="" force="true"/>
        <env name="CLOUDFLARE_TURN_API_TOKEN" value="" force="true"/>
        <!-- Twilio : des clés d'essai, jamais celles du .env (aucun SMS réel) -->
        <env name="TWILIO_ACCOUNT_SID" value="AC-essai" force="true"/>
        <env name="TWILIO_API_KEY" value="SK-essai" force="true"/>
        <env name="TWILIO_API_SECRET" value="secret-essai" force="true"/>
        <env name="APPLE_STOREKIT_XCODE" value="false" force="true"/>
        <env name="TURNSTILE_SECRET" value="secret-de-test" force="true"/>
        <env name="CORS_ALLOWED_ORIGINS" value="https://app.veterinary.test,capacitor://localhost" force="true"/>
    </php>
</phpunit>
