parameters:
	ignoreErrors:

		-
			message: '#^Using nullsafe method call on non\-nullable type Illuminate\\Console\\Command\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: database/seeders/AnnuaireSeeder.php

		-
			message: '#^Strict comparison using \!\=\= between \*NEVER\* and null will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: database/seeders/FacturationSeeder.php

		-
			message: '#^Strict comparison using \=\=\= between \*NEVER\* and null will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: database/seeders/FacturationSeeder.php

		-
			message: '#^Strict comparison using \=\=\= between App\\Enums\\StatutDevis\:\:Brouillon\|App\\Enums\\StatutDevis\:\:Envoye\|App\\Enums\\StatutDevis\:\:Refuse and App\\Enums\\StatutDevis\:\:Accepte will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: database/seeders/FacturationSeeder.php

		-
			message: '#^Ternary operator condition is always true\.$#'
			identifier: ternary.alwaysTrue
			count: 1
			path: database/seeders/PatientSeeder.php
