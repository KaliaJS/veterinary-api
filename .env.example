APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Courrier local : Mailpit attrape tous les e-mails (rien ne part).
#   brew install mailpit && brew services start mailpit
#   herd proxy mailpit http://127.0.0.1:8025 --secure   → https://mailpit.test
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@veterinary.test"
MAIL_FROM_NAME="${APP_NAME}"

# Proxys de confiance : vide en local ; « * » en production derrière le
# répartiteur de charge de Laravel Cloud (sinon toutes les requêtes ont son
# adresse IP et les limites par IP deviennent communes à tout le monde)
TRUSTED_PROXIES=
# Adresse du visiteur lue dans CF-Connecting-IP (bordure Cloudflare de
# Laravel Cloud, seule voie vers l'app) : vide, automatique (actif sur
# Laravel Cloud) ; true ou false pour forcer
IP_PAR_CLOUDFLARE=
# Formulaire de contact : l'adresse qui reçoit les messages (sinon celle des alertes)
PLATEFORME_CONTACT_EMAIL=

# Disque privé (photos, logos, consentements, audio) : local en développement,
# s3 en production avec le bucket privé de Laravel Cloud (variables AWS_* ci-dessous)
PRIVE_DISQUE=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SANCTUM_TOKEN_INACTIVITE=43200

# Front Vue (../veterinary-web). WebAuthn est lié au domaine du FRONT —
# jamais à celui de l'API : PASSKEY_RP_ID et PASSKEY_ALLOWED_ORIGINS se
# déduisent de FRONTEND_URL (les surcharger seulement si le front est
# servi sous plusieurs origines).
#
# Dev, front Vite (`npm run dev`) : http://localhost:5173 — `localhost`
# est un contexte sécurisé sans TLS, rien d'autre à faire.
#   FRONTEND_URL=http://localhost:5173
#
# Dev, front servi par Herd : le site doit être en HTTPS (`herd secure
# veterinary-web`), WebAuthn refuse http://veterinary-web.test.
#   FRONTEND_URL=https://veterinary-web.test
#
# Dev, front Vite sous son propre hôte (comme foodtruck) : entrée
# `127.0.0.1 app.veterinary.local` dans /etc/hosts, certificat mkcert
# dans ../veterinary-web, Vite en HTTPS sur le port 5174, et l'API
# en HTTPS (`herd secure veterinary-api`) pour éviter le contenu mixte.
#   FRONTEND_URL=https://app.veterinary.local:5174
#
# Un seul RP ID par déploiement : les origines listées doivent toutes
# être sur ce domaine (ou un sous-domaine).
FRONTEND_URL=http://localhost:5173

# Accès sur invitation (27.10.2026) : seules les adresses invitées créent un
# compte. Vrai par défaut et ici : en local, mettre false pour essayer
# librement ; en production, false le jour de l'ouverture seulement
ACCES_SUR_INVITATION=true

# Compte de revue d'Apple (TestFlight, App Store) : cette adresse se connecte
# avec un code fixe de 8 chiffres, sans e-mail. Le code est un secret : posé
# seulement dans Laravel Cloud. Vide : pas de compte de revue.
REVUE_APPLE_EMAIL=
REVUE_APPLE_CODE=

# Vetpoint (27.10.2026) : serveur de test par défaut. En production :
# VETPOINT_URL=https://www.vetpoint.ch/api/tapsw
# VETPOINT_PROFIL_URL=https://www.vetpoint.ch/ecommerce/control/profile
# La clé est celle de chaque clinique (Réglages, Fournisseurs), jamais ici

#PASSKEY_RP_ID=localhost
#PASSKEY_ALLOWED_ORIGINS=http://localhost:5173

# CORS : origines de l'app autorisées à appeler l'API (virgules), l'app
# iPhone comprise. Les domaines actifs des sites des cliniques s'ajoutent
# d'eux-mêmes. Toute autre origine est refusée.
CORS_ALLOWED_ORIGINS=http://localhost:5173,capacitor://localhost

# Sites web — domaines personnalisés (étape 1 : domaine déjà possédé, pointé vers nous)
#   manuel     : vérification DNS ; le serveur émet le certificat (ex. Caddy on-demand TLS
#                qui interroge /api/v1/public/domaines-autorises?domain=…)
#   cloudflare : Cloudflare for SaaS (custom hostnames) devant l'app — domaine et certificat par API
SITES_DOMAINES_FOURNISSEUR=manuel
SITES_CIBLE_CNAME=sites.veterinary.ch
SITES_IP=
# Local seulement : les domaines en .test comptent comme pointés (pas de DNS réel)
SITES_DOMAINES_TEST_AUTO=false
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Stripe : paiements en caisse (Terminal, TWINT) et acomptes, sur le compte
# Connect de chaque société. Second webhook pour les événements des comptes
# connectés (même adresse, secret à part ; en local, stripe listen
# --forward-connect-to donne le même secret). Commission de la plateforme en
# pour cent : terminal, TWINT à la caisse et acomptes en ligne.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_COMPTES=
STRIPE_COMMISSION_TERMINAL=0.5
STRIPE_COMMISSION_TWINT=0.5
STRIPE_COMMISSION_EN_LIGNE=0.5
REFDATA_API_KEY=
CATALOGUE_NOTIFICATION_EMAIL=

# Achats de test lancés depuis Xcode (fichier StoreKit), local seulement
APPLE_STOREKIT_XCODE=false

# Transcription des consultations : Deepgram (clé « Default »,
# permission usage:write), Claude pour le compte rendu. Budget mensuel
# Deepgram en dollars (vide : illimité), coût d'une minute d'après la
# console Deepgram, alerte à 80 % et 100 % du budget
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
# Budget mensuel estimé chez Anthropic (dollars) : au-delà, rédactions et suggestions attendent le mois suivant
ANTHROPIC_BUDGET_USD=
TRANSCRIPTION_BUDGET_DEEPGRAM_USD=
TRANSCRIPTION_COUT_MINUTE_DEEPGRAM_USD=0.0065
TRANSCRIPTION_ALERTE_EMAIL=

# Suggestion diagnostique (Claude, même clé) : prix d'une suggestion
# rendue, en centimes, et effort de réflexion (low | medium | high | xhigh | max)
DIAGNOSTIC_TARIF_CENTIMES=50
DIAGNOSTIC_EFFORT=high

# Inscription des cliniques : le GLN est cherché dans MedReg (appels
# publics du site de l'OFSP) ; sinon un e-mail part ici pour valider ou
# refuser à la main (vide : l'adresse d'alerte de la transcription, puis
# celle de l'émetteur ; à remplir en production)
PLATEFORME_VERIFICATION_EMAIL=
# Alertes techniques (jeton Cloudflare refusé) ; à défaut, l'adresse de vérification
PLATEFORME_ALERTE_EMAIL=
MEDREG_URL=https://healthreg-public.admin.ch/medreg/api/public

# Captcha Cloudflare Turnstile des demandes de rendez-vous sans compte
# (clé secrète du widget ; la clé de site va dans VITE_TURNSTILE_SITE_KEY
# du front). En local, la clé de test de Cloudflare qui accepte tout :
# 1x0000000000000000000000000000000AA
TURNSTILE_SECRET=

# Production : comptes dont les achats de test (Sandbox) valent (revue d'Apple, Jim), séparés par des virgules
APPLE_COMPTES_SANDBOX=

# Téléconsultation (WebRTC, 28.10.2026) : TURN de Cloudflare (Realtime > TURN Server).
# L'API crée des identifiants temporaires ; vides, STUN seulement (la plupart des appels
# passent, pas ceux derrière un réseau d'entreprise strict)
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
CLOUDFLARE_TURN_TTL=14400
